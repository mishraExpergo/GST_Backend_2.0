{
  "info": {
    "_postman_id": "9af4f104-2494-4af0-8a58-2d5f4b898acd",
    "name": "GST Taxpayer Auth Flow",
    "description": "End-to-end taxpayer authentication flow for GST backend.\n\nRun order:\n1) Generate OTP\n2) Submit OTP\n3) Verify OTP\n4) Refresh Token\n5) Session Status",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Generate OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"gstin\": \"{{gstin}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/gst/taxpayer/otp/generate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gst",
            "taxpayer",
            "otp",
            "generate"
          ]
        },
        "description": "Triggers OTP generation on Sandbox for the provided taxpayer identity."
      },
      "response": []
    },
    {
      "name": "2. Submit OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"gstin\": \"{{gstin}}\",\n  \"otp\": \"{{otp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/gst/taxpayer/otp/submit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gst",
            "taxpayer",
            "otp",
            "submit"
          ]
        },
        "description": "Stores OTP in backend. OTP is valid for 10 minutes (configurable)."
      },
      "response": []
    },
    {
      "name": "3. Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"gstin\": \"{{gstin}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/gst/taxpayer/otp/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gst",
            "taxpayer",
            "otp",
            "verify"
          ]
        },
        "description": "Verifies previously submitted OTP and stores taxpayer access token in backend session."
      },
      "response": []
    },
    {
      "name": "4. Refresh Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"gstin\": \"{{gstin}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/gst/taxpayer/session/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gst",
            "taxpayer",
            "session",
            "refresh"
          ]
        },
        "description": "Manually refreshes taxpayer access token."
      },
      "response": []
    },
    {
      "name": "5. Session Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/gst/taxpayer/session/status?username={{username}}&gstin={{gstin}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gst",
            "taxpayer",
            "session",
            "status"
          ],
          "query": [
            {
              "key": "username",
              "value": "{{username}}"
            },
            {
              "key": "gstin",
              "value": "{{gstin}}"
            }
          ]
        },
        "description": "Returns current state and expiry details for the taxpayer auth session."
      },
      "response": []
    },
    {
      "name": "6. GSTR-1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/gst/taxpayer/gstr-1/{{year}}/{{month}}?username={{username}}&gstin={{gstin}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gst",
            "taxpayer",
            "gstr-1",
            "{{year}}",
            "{{month}}"
          ],
          "query": [
            {
              "key": "username",
              "value": "{{username}}"
            },
            {
              "key": "gstin",
              "value": "{{gstin}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "7. GSTR-2B",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/gst/taxpayer/gstr-2b/{{year}}/{{month}}?username={{username}}&gstin={{gstin}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gst",
            "taxpayer",
            "gstr-2b",
            "{{year}}",
            "{{month}}"
          ],
          "query": [
            {
              "key": "username",
              "value": "{{username}}"
            },
            {
              "key": "gstin",
              "value": "{{gstin}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "8. GSTR-3B",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/gst/taxpayer/gstr-3b/{{year}}/{{month}}?username={{username}}&gstin={{gstin}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gst",
            "taxpayer",
            "gstr-3b",
            "{{year}}",
            "{{month}}"
          ],
          "query": [
            {
              "key": "username",
              "value": "{{username}}"
            },
            {
              "key": "gstin",
              "value": "{{gstin}}"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "username",
      "value": "acme.com"
    },
    {
      "key": "gstin",
      "value": "29AAACQ3770E000"
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "year",
      "value": "2024"
    },
    {
      "key": "month",
      "value": "1"
    }
  ]
}

PORT=3000
HOST=0.0.0.0

# JWT authentication (protects all HTTP routes except POST /auth/login)
# Clients send: Authorization: Bearer <access_token>
JWT_AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
# Bootstrap admin user (created on first startup if users table is empty)
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=change-me-strong-password

# MongoDB (required for verify-and-fetch / GSTR storage)
MONGO_URI=mongodb://localhost:27017/gst_app
ENABLE_MONGO=true

# PostgreSQL (required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gst_app
# First empty-DB deploy: set true once, start app, then set false
POSTGRES_SYNC=false
# Managed RDS / cloud Postgres
POSTGRES_SSL=false

# RabbitMQ (optional; false = inline jobs)
ENABLE_RABBITMQ=false
RABBITMQ_URL=amqp://localhost:5672

# External GST compliance API
# NOTE: ENABLE_MONGO must be true for verify-and-fetch; results go to MongoDB.
# Keys must match host:
#   test-api.sandbox.co.in  → GST_API_KEY + GST_API_SECRET
#   api.sandbox.co.in       → GST_API_KEY_LIVE + GST_API_SECRET_LIVE
GST_API_BASE_URL=https://test-api.sandbox.co.in
GST_API_AUTH_URL=
GST_API_KEY=
GST_API_SECRET=
GST_API_KEY_LIVE=
GST_API_SECRET_LIVE=
GST_API_VERSION=1.0.0
GST_API_ACCEPT_CACHE=true

# verify-and-fetch tuning
GST_VERIFY_BATCH_SIZE=50
GST_VERIFY_CONCURRENCY=5
GST_API_MAX_RETRIES=3
GST_API_RETRY_BASE_MS=500

# Taxpayer OTP/session authentication flow
GST_TAXPAYER_SOURCE=primary
GST_TAXPAYER_OTP_TTL_MINUTES=10
GST_TAXPAYER_TOKEN_TTL_HOURS=6
GST_TAXPAYER_REFRESH_LEAD_MINUTES=15
GST_TAXPAYER_REFRESH_INTERVAL_MS=300000
GST_TAXPAYER_REFRESH_ON_EVERY_REQUEST=true

# Optional: override DNS for mongodb+srv (comma-separated)
# DNS_SERVERS=8.8.8.8,1.1.1.1
